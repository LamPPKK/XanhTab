{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireball.example/schemas/xanhtab-release-manifest-v1.json",
  "title": "XanhTab signed release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "config_schema_version", "gstreamer_abi", "component_versions", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9.-]+)?$" },
    "config_schema_version": { "const": 1 },
    "gstreamer_abi": { "const": "1.0" },
    "component_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wpe_webkit", "gstreamer", "rswebrtc"],
      "properties": {
        "wpe_webkit": { "type": "string", "minLength": 1 },
        "gstreamer": { "type": "string", "minLength": 1 },
        "rswebrtc": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "name", "url", "sha256"],
        "properties": {
          "platform": { "const": "linux-aarch64" },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
