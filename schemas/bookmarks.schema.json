{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireball.example/schemas/xanhtab-bookmarks-v1.json",
  "title": "XanhTab bookmarks v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bookmarks"],
  "properties": {
    "schema_version": { "const": 1 },
    "bookmarks": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 256 },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 4096,
            "pattern": "^https?://[^/?#@]+(?:/|$)"
          }
        }
      }
    }
  }
}
