{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fireball.example/schemas/xanhtab-config-v1.json",
  "title": "XanhTab configuration v1",
  "$comment": "This schema validates structure and local constraints. xanhtabd additionally enforces that allowed_origins contains the normalized public_base_url origin and that SocketAddr values parse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "session", "browser", "signaling", "network", "blocklist"],
  "allOf": [
    {
      "if": {
        "properties": {
          "server": {
            "type": "object",
            "properties": { "allow_insecure_http": { "const": false } },
            "required": ["allow_insecure_http"]
          }
        },
        "required": ["server"]
      },
      "then": {
        "properties": {
          "server": {
            "type": "object",
            "required": ["tls_cert", "tls_key"],
            "properties": {
              "public_base_url": { "type": "string", "pattern": "^https://[^/?#@]+/?$" },
              "tls_cert": { "type": "string", "pattern": "^/" },
              "tls_key": { "type": "string", "pattern": "^/" },
              "secure_cookies": { "const": true },
              "static_dir": { "type": "string", "pattern": "^/" },
              "allowed_origins": {
                "type": "array",
                "items": { "type": "string", "pattern": "^https://[^/?#@]+/?$" }
              }
            }
          },
          "browser": {
            "type": "object",
            "properties": {
              "enabled": { "const": true },
              "command": { "type": "string", "pattern": "^/" },
              "socket": { "type": "string", "pattern": "^/run/" }
            }
          },
          "signaling": {
            "type": "object",
            "properties": { "enabled": { "const": true } }
          },
          "network": {
            "type": "object",
            "required": ["control_uid"],
            "properties": {
              "enabled": { "const": true },
              "control_uid": { "type": "integer", "minimum": 1 },
              "netd_socket": { "type": "string", "pattern": "^/run/" }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen", "public_base_url", "static_dir", "secure_cookies", "allow_insecure_http", "allowed_origins"],
      "properties": {
        "listen": { "type": "string", "pattern": "^((([0-9]{1,3}\\.){3}[0-9]{1,3})|\\[[0-9A-Fa-f:]+\\]):[0-9]+$" },
        "public_base_url": { "type": "string", "format": "uri", "pattern": "^https?://[^/?#@]+/?$" },
        "static_dir": { "type": "string", "minLength": 1 },
        "tls_cert": { "type": ["string", "null"], "pattern": "^/" },
        "tls_key": { "type": ["string", "null"], "pattern": "^/" },
        "secure_cookies": { "type": "boolean" },
        "allow_insecure_http": { "type": "boolean" },
        "allowed_origins": {
          "type": "array",
          "items": { "type": "string", "format": "uri", "pattern": "^https?://[^/?#@]+/?$" },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "dependentRequired": {
        "tls_cert": ["tls_key"],
        "tls_key": ["tls_cert"]
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_dir", "pairing_file", "auth_ttl_seconds", "ticket_ttl_seconds", "auto_burn_seconds", "initial_url", "initial_profile"],
      "properties": {
        "runtime_dir": { "type": "string", "pattern": "^/" },
        "pairing_file": { "type": "string", "pattern": "^/" },
        "auth_ttl_seconds": { "type": "integer", "minimum": 300 },
        "ticket_ttl_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "auto_burn_seconds": { "type": "integer", "minimum": 0 },
        "initial_url": { "type": "string", "format": "uri" },
        "initial_profile": { "enum": ["1080p30", "720p15", "480p10"] }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "command", "socket", "stop_timeout_seconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "command": { "type": "string", "minLength": 1 },
        "socket": { "type": "string", "pattern": "^/" },
        "stop_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "ipc_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "signaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "upstream_uri", "plugin_directory"],
      "properties": {
        "enabled": { "type": "boolean" },
        "upstream_uri": { "type": "string", "pattern": "^wss?://(127\\.0\\.0\\.1|\\[?::1\\]?|localhost)(:[0-9]+)?(/.*)?$" },
        "plugin_directory": { "type": "string", "pattern": "^/" },
        "stun_config_file": { "type": ["string", "null"], "pattern": "^/" },
        "turn_config_file": { "type": ["string", "null"], "pattern": "^/" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "initial_mode", "netd_socket", "ipc_timeout_seconds", "browser_uid", "tor_proxy", "warp_proxy", "wireguard_config", "proxy_url_file", "proxy_endpoint"],
      "properties": {
        "enabled": { "type": "boolean" },
        "initial_mode": { "enum": ["direct", "tor", "warp", "wireguard", "proxy"] },
        "netd_socket": { "type": "string", "pattern": "^/" },
        "ipc_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "control_uid": { "type": "integer", "minimum": 1 },
        "browser_uid": { "type": "integer", "minimum": 1 },
        "tor_proxy": { "type": "string", "pattern": "^socks5h?://(127\\.0\\.0\\.1|\\[::1\\]):[0-9]+/?$" },
        "warp_proxy": { "type": "string", "pattern": "^socks5h?://(127\\.0\\.0\\.1|\\[::1\\]):[0-9]+/?$" },
        "wireguard_config": { "type": "string", "pattern": "^/.*/wg0\\.conf$" },
        "proxy_url_file": { "type": "string", "pattern": "^/" },
        "proxy_endpoint": { "type": "string", "pattern": "^((([0-9]{1,3}\\.){3}[0-9]{1,3})|\\[[0-9A-Fa-f:]+\\]):[0-9]+$" }
      }
    },
    "blocklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fst_path", "custom_hosts_path"],
      "properties": {
        "fst_path": { "type": "string" },
        "custom_hosts_path": { "type": "string" }
      }
    }
  }
}
