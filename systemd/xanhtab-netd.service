[Unit]
Description=XanhTab validated egress policy helper
Documentation=https://github.com/LamPPKK/XanhTab
After=network-online.target nftables.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=xanhtab
ExecStart=/usr/local/libexec/xanhtab-netd --config /etc/xanhtab/xanhtab.toml
ExecStopPost=-/usr/sbin/nft delete table inet xanhtab
Restart=on-failure
RestartSec=2s
UMask=0077
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/run/xanhtab
ReadOnlyPaths=/etc/xanhtab
MemoryMax=32M
TasksMax=16

[Install]
WantedBy=multi-user.target
